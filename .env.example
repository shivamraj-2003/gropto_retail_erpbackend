# Postgres connection string (Supabase project's Session Pooler string works directly,
# or any other Postgres). FastAPI uses asyncpg at runtime; Alembic swaps in psycopg2
# automatically for migrations (see alembic/env.py) — put the asyncpg form here.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
DEVICE_OFFLINE_MAX_DAYS=14

# AI (optional, Phase 1 P1 feature)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1/chat/completions
AI_DAILY_CALL_CAP=200
# ERP assistant: full chat endpoint URL, model name, and "openai" (OpenAI-compatible) or "anthropic"
AI_PROVIDER_KIND=openai
AI_MODEL=gpt-4.1-mini
AI_MAX_TOKENS=600
AI_TIMEOUT_SECONDS=30

CORS_ORIGINS=http://localhost:5173,app://.
ENVIRONMENT=development

# Paytm Wireless POS (optional). Sends the bill amount to the Paytm card machine beside the till. Leave the merchant
# key blank to keep the POS on its plain tender buttons (/api/v1/payments/config reports enabled: false).
# The merchant key and channel id come from Paytm; never put them in the app or in git.
# These are only the DEFAULTS. Each store can have its own Paytm account: an admin enters it per machine under
# Tills & Devices > Paytm card machines (MID, TID, channel id, merchant key, environment, server address). The
# merchant key saved there is encrypted with SECRETS_KEY (or JWT_SECRET when that is empty). Set SECRETS_KEY once
# and never change it.
SECRETS_KEY=
# PAYTM_BASE_URL: leave empty for staging. For production set the host Paytm gives you when POS integration is activated.
PAYTM_ENVIRONMENT=staging
PAYTM_MERCHANT_KEY=
PAYTM_CHANNEL_ID=
PAYTM_BASE_URL=
PAYTM_MID=Gropto97235153553029
PAYTM_TID=26537016
PAYTM_DEVICE_SERIAL=1494817388

# WhatsApp Business Cloud API (Meta, optional). Leave blank to keep CRM
# campaigns as audience-planning only — sending refuses with "not configured".
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Resend (optional, email via a single API key from resend.com — no SMTP
# server to run). Leave blank and forgot-password falls back to flagging the
# request for an Admin to reset directly instead of emailing an OTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gropto ERP <onboarding@resend.dev>

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Redis (Upstash) ------------------------------------------------------
# TCP connection string (TLS, so rediss://). Backs rate limiting, login
# lockout, OTP resend throttling, cross-process permission-cache
# invalidation, scheduler locks, and the Celery broker. Leave blank for
# single-process in-memory mode (dev).
REDIS_URL=
# REST fallback for the key-value features if only HTTPS is reachable
# (Celery still needs REDIS_URL).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=gropto
# Queue notifications to the Celery worker when REDIS_URL is set.
CELERY_ENABLED=true

# --- OTP delivery ---------------------------------------------------------
# SMS provider for OTPs: auto | msg91 | twilio  (auto = MSG91 if set, else Twilio)
SMS_PROVIDER=auto
# MSG91: auth key + DLT-approved OTP template (with an ##OTP## variable)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
# WhatsApp: name of a Meta-approved authentication template with one body
# variable (the code); uses WHATSAPP_PHONE_NUMBER_ID/ACCESS_TOKEN above.
WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_OTP_LANGUAGE=en_US
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# --- Security / capacity --------------------------------------------------
# Mandatory MFA for privileged roles. false = emergency break-glass only.
MFA_ENFORCEMENT=true
REPORTING_POOL_SIZE=2
REPORTING_MAX_OVERFLOW=1
# Gunicorn workers per container. Each worker opens 5+5 (+2+1) DB
# connections — keep the total under your pooler's limit (15 here).
WEB_CONCURRENCY=1

# --- Database connections ---------------------------------------------------
# Session pooler (port 5432) caps at 15 connections: keep WEB_CONCURRENCY=1 and
# the defaults below. Transaction pooler (port 6543) lets many workers share few
# server connections: use it for the API, raise the pool, and put the direct /
# session URL in MIGRATION_DATABASE_URL for Alembic and backups.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# MIGRATION_DATABASE_URL=

# Production on Supabase: use the pooler connection strings (the VPS may not have IPv6, which Supabase's direct
# connection needs). Recommended: DATABASE_URL = session pooler (port 5432, keep WEB_CONCURRENCY=1) or transaction
# pooler (port 6543); MIGRATION_DATABASE_URL = session pooler (port 5432), always required with port 6543.
#
# --- Deployment (Hostinger VPS, see DEPLOY.md) ----------------------------
# Domain Caddy serves with automatic HTTPS (api.example.com). Leave unset to serve plain HTTP on the server's IP.
SITE_ADDRESS=
